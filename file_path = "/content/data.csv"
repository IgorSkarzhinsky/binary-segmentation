      "source": [
        "\"\"\"\n",
        "Wildberries Price Parser\n",
        "Сбор данных о товарах: цены, рейтинги, отзывы\n",
        "Парсинг через поисковый API WB\n",
        "\"\"\"\n",
        "\n",
        "import requests\n",
        "import sqlite3\n",
        "import json\n",
        "import time\n",
        "from datetime import datetime\n",
        "from typing import List, Dict, Optional\n",
        "\n",
        "class WildberriesParser:\n",
        "    \"\"\"\n",
        "    Парсер цен и характеристик товаров Wildberries\n",
        "\n",
        "    Основные эндпоинты:\n",
        "    - Поисковый API: https://search.wb.ru/exactmatch/ru/common/v18/search\n",
        "    - Карточка товара: https://card.wb.ru/cards/v2/detail\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, database_path=\"wb_prices.db\"):\n",
        "        self.session = requests.Session()\n",
        "        self.session.headers.update({\n",
        "            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n",
        "            'Accept': 'application/json',\n",
        "            'Accept-Language': 'ru-RU,ru;q=0.9'\n",
        "        })\n",
        "\n",
        "        # Параметры поиска [citation:5]\n",
        "        self.base_search_url = \"https://search.wb.ru/exactmatch/ru/common/v18/search\"\n",
        "\n",
        "        # Базовые параметры\n",
        "        self.base_params = {\n",
        "            \"ab_testing\": False,\n",
        "            \"appType\": 1,\n",
        "            \"curr\": \"rub\",\n",
        "            \"dest\": -1257786,\n",
        "            \"inheritFilters\": False,\n",
        "            \"lang\": \"ru\",\n",
        "            \"resultset\": \"catalog\",\n",
        "            \"sort\": \"popular\",\n",
        "            \"spp\": 30,\n",
        "            \"suppressSpellcheck\": False\n",
        "        }\n",
        "\n",
        "        self.init_database(database_path)\n",
        "\n",
        "    def init_database(self, db_path: str):\n",
        "        \"\"\"Инициализация базы данных для хранения цен\"\"\"\n",
        "        self.conn = sqlite3.connect(db_path)\n",
        "        self.cursor = self.conn.cursor()\n",
        "\n",
        "        self.cursor.execute(\"\"\"\n",
        "            CREATE TABLE IF NOT EXISTS products (\n",
        "                id INTEGER PRIMARY KEY,\n",
        "                name TEXT,\n",
        "                brand TEXT,\n",
        "                rating REAL,\n",
        "                feedbacks INTEGER,\n",
        "                basic_price INTEGER,\n",
        "                discount_price INTEGER,\n",
        "                wb_wallet_price INTEGER,\n",
        "                last_updated TIMESTAMP\n",
        "            )\n",
        "        \"\"\")\n",
        "\n",
        "        self.cursor.execute(\"\"\"\n",
        "            CREATE TABLE IF NOT EXISTS price_history (\n",
        "                id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "                product_id INTEGER,\n",
        "                price INTEGER,\n",
        "                discount_price INTEGER,\n",
        "                timestamp TIMESTAMP,\n",
        "                FOREIGN KEY (product_id) REFERENCES products (id)\n",
        "            )\n",
        "        \"\"\")\n",
        "\n",
        "        self.conn.commit()\n",
        "\n",
        "    def search_products(self, query: str, pages: int = 1) -> List[Dict]:\n",
        "        \"\"\"\n",
        "        Поиск товаров по ключевому слову\n",
        "\n",
        "        Args:\n",
        "            query: поисковый запрос\n",
        "            pages: количество страниц для парсинга (по 100 товаров на странице)\n",
        "\n",
        "        Returns:\n",
        "            Список товаров с полями: id, name, price, discount, rating, feedbacks\n",
        "        \"\"\"\n",
        "        all_products = []\n",
        "\n",
        "        for page in range(1, pages + 1):\n",
        "            params = self.base_params.copy()\n",
        "            params.update({\n",
        "                \"query\": query,\n",
        "                \"page\": page\n",
        "            })\n",
        "\n",
        "            try:\n",
        "                response = self.session.get(self.base_search_url, params=params)\n",
        "                response.raise_for_status()\n",
        "                data = response.json()\n",
        "\n",
        "                products = data.get('data', {}).get('products', [])\n",
        "\n",
        "                for product in products:\n",
        "                    parsed = self._parse_product(product)\n",
        "                    if parsed:\n",
        "                        all_products.append(parsed)\n",
        "\n",
        "                print(f\"Страница {page}: найдено {len(products)} товаров\")\n",
        "                time.sleep(0.5)  # Задержка между страницами\n",
        "\n",
        "            except Exception as e:\n",
        "                print(f\"Ошибка при парсинге страницы {page}: {e}\")\n",
        "                continue\n",
        "\n",
        "        return all_products\n",
        "\n",
        "    def _parse_product(self, product: Dict) -> Optional[Dict]:\n",
        "        \"\"\"\n",
        "        Извлечение данных из JSON-ответа WB\n",
        "\n",
        "        Цены приходят в копейках, делим на 100 для рублей [citation:2][citation:5]\n",
        "        \"\"\"\n",
        "        try:\n",
        "            # Базовая информация\n",
        "            product_id = product.get('id')\n",
        "            name = product.get('name', '')\n",
        "            brand = product.get('brand', '')\n",
        "            rating = product.get('rating', 0)\n",
        "            feedbacks = product.get('feedbacks', 0)\n",
        "\n",
        "            # Цены из вложенной структуры sizes [citation:5]\n",
        "            sizes = product.get('sizes', [])\n",
        "            if sizes:\n",
        "                price_data = sizes[0].get('price', {})\n",
        "                basic_price = price_data.get('basic', 0) // 100  # копейки -> рубли\n",
        "                discount_price = price_data.get('product', 0) // 100\n",
        "                wb_wallet_price = price_data.get('wb_wallet', 0) // 100\n",
        "            else:\n",
        "                basic_price = product.get('priceU', 0) // 100\n",
        "                discount_price = product.get('salePriceU', 0) // 100\n",
        "                wb_wallet_price = 0\n",
        "\n",
        "            return {\n",
        "                'id': product_id,\n",
        "                'name': name,\n",
        "                'brand': brand,\n",
        "                'rating': rating,\n",
        "                'feedbacks': feedbacks,\n",
        "                'basic_price': basic_price,\n",
        "                'discount_price': discount_price,\n",
        "                'wb_wallet_price': wb_wallet_price\n",
        "            }\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Ошибка парсинга товара: {e}\")\n",
        "            return None\n",
        "\n",
        "    def save_products(self, products: List[Dict]):\n",
        "        \"\"\"Сохранение товаров в БД с историей цен\"\"\"\n",
        "        for product in products:\n",
        "            # Обновляем или вставляем товар\n",
        "            self.cursor.execute(\"\"\"\n",
        "                INSERT OR REPLACE INTO products\n",
        "                (id, name, brand, rating, feedbacks, basic_price, discount_price, wb_wallet_price, last_updated)\n",
        "                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n",
        "            \"\"\", (\n",
        "                product['id'], product['name'], product['brand'],\n",
        "                product['rating'], product['feedbacks'],\n",
        "                product['basic_price'], product['discount_price'],\n",
        "                product['wb_wallet_price'], datetime.now()\n",
        "            ))\n",
        "\n",
        "            # Добавляем запись в историю цен\n",
        "            self.cursor.execute(\"\"\"\n",
        "                INSERT INTO price_history (product_id, price, discount_price, timestamp)\n",
        "                VALUES (?, ?, ?, ?)\n",
        "            \"\"\", (\n",
        "                product['id'], product['basic_price'],\n",
        "                product['discount_price'], datetime.now()\n",
        "            ))\n",
        "\n",
        "        self.conn.commit()\n",
        "        print(f\"Сохранено {len(products)} товаров\")\n",
        "\n",
        "    def get_competitor_prices(self, product_id: int) -> List[Dict]:\n",
        "        \"\"\"\n",
        "        Получение цен конкурентов для конкретного товара\n",
        "        Находим похожие товары по категории/бренду\n",
        "        \"\"\"\n",
        "        # Сначала получаем информацию о товаре\n",
        "        self.cursor.execute(\"SELECT brand, name FROM products WHERE id = ?\", (product_id,))\n",
        "        product = self.cursor.fetchone()\n",
        "\n",
        "        if not product:\n",
        "            return []\n",
        "\n",
        "        brand, name = product\n",
        "\n",
        "        # Ищем похожие товары по бренду\n",
        "        self.cursor.execute(\"\"\"\n",
        "            SELECT id, name, discount_price, rating, feedbacks\n",
        "            FROM products\n",
        "            WHERE brand = ? AND id != ?\n",
        "            ORDER BY discount_price\n",
        "            LIMIT 20\n",
        "        \"\"\", (brand, product_id))\n",
        "\n",
        "        return [{\n",
        "            'id': row[0],\n",
        "            'name': row[1],\n",
        "            'price': row[2],\n",
        "            'is_cheaper': row[2] < self.get_current_price(product_id)\n",
        "        } for row in self.cursor.fetchall()]\n",
        "\n",
        "    def get_current_price(self, product_id: int) -> int:\n",
        "        \"\"\"Получение текущей цены товара\"\"\"\n",
        "        self.cursor.execute(\n",
        "            \"SELECT discount_price FROM products WHERE id = ?\",\n",
        "            (product_id,)\n",
        "        )\n",
        "        result = self.cursor.fetchone()\n",
        "        return result[0] if result else 0\n",
        "\n",
        "    def get_price_history(self, product_id: int, days: int = 30) -> List[Dict]:\n",
        "        \"\"\"История изменения цен за период\"\"\"\n",
        "        self.cursor.execute(\"\"\"\n",
        "            SELECT price, discount_price, timestamp\n",
        "            FROM price_history\n",
        "            WHERE product_id = ?\n",
        "            AND timestamp > datetime('now', ?)\n",
        "            ORDER BY timestamp\n",
        "        \"\"\", (product_id, f'-{days} days'))\n",
        "\n",
        "        return [{\n",
        "            'price': row[0],\n",
        "            'discount_price': row[1],\n",
        "            'date': row[2]\n",
        "        } for row in self.cursor.fetchall()]\n",
        "\n",
        "    def close(self):\n",
        "        self.conn.close()\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 🚀 Пример использования\n",
        "# ======================================================\n",
        "\n",
        "def main():\n",
        "    parser = WildberriesParser(\"wb_prices.db\")\n",
        "\n",
        "    # Парсим товары по запросу\n",
        "    query = input(\"Введите товар для поиска: \")\n",
        "    pages = int(input(\"Количество страниц (1-5): \"))\n",
        "\n",
        "    print(f\"\\n🔍 Парсинг товаров по запросу '{query}'...\")\n",
        "    products = parser.search_products(query, pages)\n",
        "\n",
        "    if products:\n",
        "        parser.save_products(products)\n",
        "\n",
        "        print(\"\\n📊 Топ-5 найденных товаров:\")\n",
        "        for i, p in enumerate(products[:5], 1):\n",
        "            print(f\"{i}. {p['name'][:50]}...\")\n",
        "            print(f\"   Цена: {p['discount_price']} ₽ | Рейтинг: {p['rating']} | Отзывов: {p['feedbacks']}\")\n",
        "            print()\n",
        "\n",
        "        # Пример: анализ цен конкурентов для первого товара\n",
        "        first_id = products[0]['id']\n",
        "        print(f\"\\n🔎 Анализ конкурентов для товара #{first_id}:\")\n",
        "        competitors = parser.get_competitor_prices(first_id)\n",
        "\n",
        "        cheaper_count = sum(1 for c in competitors if c['is_cheaper'])\n",
        "        print(f\"Найдено {len(competitors)} похожих товаров, из них {cheaper_count} дешевле\")\n",
        "\n",
        "        if cheaper_count > 0:\n",
        "            cheapest = min(competitors, key=lambda x: x['price'])\n",
        "            print(f\"💰 Самый дешёвый конкурент: {cheapest['price']} ₽\")\n",
        "\n",
        "    parser.close()\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ],
